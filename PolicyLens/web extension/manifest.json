{
    "manifest_version": 3,

    "name": "PolicyLens (Dev)",

    "version": "0.1.0",

    "description": "Know what you're agreeing to.",

    "permissions": [
        "activeTab",
        "scripting"
    ],

    "host_permissions": [
        "http://localhost:8000/*"
    ],

    "action": {
        "default_popup": "src/UI/index.html"
    },

    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "js": [
                "src/content/policyVocabulary.js",
                "src/content/extractor.js",
                "src/content/cleaner.js",
                "src/content/detector.js",
                "src/content/index.js"
            ]
        }
    ]
}